#!/bin/bash
# launchd 运行的后台服务：用 App 里自带的 Node 启动 Kiki。日志在 ~/Library/Logs/Kiki/server.log
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
export KIKI_APP="$(cd "$RES/../.." && pwd)"   # 告诉 Kiki 自己装在哪，自动更新要用
export DATA_DIR="${DATA_DIR:-$HOME/kiki-data}"
NODE="$RES/node/bin/node"
MAIN="$RES/app/dist/main.js"
ENVF="$DATA_DIR/.env"
# 工作目录放在数据目录，Kiki 会读这里的 .env；第一次启动时数据目录还没建，先待在家目录
cd "$DATA_DIR" 2>/dev/null || cd "$HOME"

# 先把 .env 里的密钥引用换成真值再启动，取不到也照样启动（不能让后台卡住，否则自动更新会判定失败）：
#   KEY=keychain:<名字>   从 macOS 钥匙串取（推荐：登录后就能取，不用每次授权）
#   KEY=op://…            从 1Password 取（最多等 20 秒；后台常常拿不到授权，见 docs/mac-app.md）
op_read() {
  command -v op >/dev/null 2>&1 || return 0
  local out pid timer
  out=$(mktemp)
  op read "$1" >"$out" 2>/dev/null &
  pid=$!
  ( sleep 20; kill "$pid" 2>/dev/null ) &
  timer=$!
  wait "$pid" 2>/dev/null
  kill "$timer" 2>/dev/null
  cat "$out"
  rm -f "$out"
}
if [ -f "$ENVF" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    val="${line#*=}"
    val="${val%\"}"; val="${val#\"}"; val="${val%\'}"; val="${val#\'}"
    case "$val" in
      keychain:*) v=$(security find-generic-password -s "${val#keychain:}" -w 2>/dev/null) ;;
      op://*) v=$(op_read "$val") ;;
      *) continue ;;
    esac
    [ -n "$v" ] || echo "[$(date '+%F %T')] 取不到 ${key}（${val}），先不带它启动"
    export "$key=$v"   # 取不到也设成空值，免得 Kiki 把引用原文当成密钥
  done < "$ENVF"
fi
exec "$NODE" "$MAIN"
