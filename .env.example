# Telegram：找 @BotFather 建机器人拿 token
TELEGRAM_BOT_TOKEN=
# 只回应这些聊天（逗号分隔）。不知道自己的 chat id？先留空启动，给机器人发条消息，日志里会打印出来
TELEGRAM_ALLOWED_CHATS=

# 模型：pi 内置 DeepSeek
DEEPSEEK_API_KEY=
MODEL=deepseek/deepseek-v4-flash

# 你的数据放哪（关于我、各个 agent 的说明和对话记录）
DATA_DIR=~/kiki-data
# 没选对话时直接说话，落到哪个 agent 的哪段对话
DEFAULT_AGENT=life
