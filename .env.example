# 模型：pi 内置 DeepSeek
DEEPSEEK_API_KEY=
MODEL=deepseek/deepseek-flash

# 你的数据放哪（关于我、各个 agent 的说明和对话记录）
DATA_DIR=~/kiki-data
# 主 bot 收到普通消息、又没选过对话时，落到哪个 agent
DEFAULT_AGENT=奇奇
# 网页端口：http://localhost:4567
PORT=4567

# 收发室多久去外部 agent 那里看一次（秒），默认 60。信箱格式见 数据目录/postroom/mailbox/README.md
# POSTROOM_POLL_SEC=60
